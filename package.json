{
  "name": "resonance",
  "version": "1.0.0",
  "private": true,
  "description": "Link Spotify or Apple Music for stats, recommendations and a taste-based feed",
  "type": "module",
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "serve": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^26.6.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
