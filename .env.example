# Everything here is optional: the Client ID and API keys can be set in the admin panel instead.
PORT=3000
# Spotify requires a loopback IP (not "localhost") for redirect URIs
BASE_URL=http://127.0.0.1:3000

# Track accounts from copies running elsewhere (same Client ID).
# On the copy that should see everyone (public https URL): set only REPORT_KEY.
# On the other copies: set REPORT_URL to that copy's URL, plus the same REPORT_KEY.
# REPORT_URL=
# REPORT_KEY=

# Optional: you can paste this in the app instead (⚙ settings). Create an app at https://developer.spotify.com/dashboard
# Redirect URI to add there: http://127.0.0.1:3000/auth/spotify/callback
SPOTIFY_CLIENT_ID=

# --- Optional integrations (also settable in the app via ⚙) ---
# Last.fm (free): "fans of X also love Y" recommendations
LASTFM_API_KEY=
# Ticketmaster (free): concerts for your top artists in the feed
TICKETMASTER_API_KEY=
TICKETMASTER_CITY=
TICKETMASTER_COUNTRY=US
# Anthropic API: "Why?" explanations on recommendations and a taste summary
ANTHROPIC_API_KEY=
